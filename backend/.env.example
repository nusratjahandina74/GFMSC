# # ===== GFMSC backend configuration (copy to .env — NEVER commit .env) =====
# NODE_ENV=development
# PORT=5000

# # MongoDB. Use an Atlas replica set in production (needed for transactions).
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/GFMSC?retryWrites=true&w=majority
# # Set to true in production: refuse to run multi-document operations without real transactions.
# REQUIRE_TRANSACTIONS=false

# # ---- REQUIRED secrets (the server refuses to start without them) ----
# # Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# # They must be DIFFERENT from each other, >= 32 chars, and never reused from any public place.
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# # One-time bootstrap of the first SuperAdmin via POST /api/auth/superadmin (header X-Bootstrap-Secret).
# # Leave EMPTY to disable that endpoint entirely (recommended; use `npm run create-superadmin` instead).
# BOOTSTRAP_SECRET=

# # ---- URLs ----
# BACKEND_URL=http://localhost:5000
# BASE_RETURN_URL=http://localhost:5173
# # Number of reverse proxies in front of the API (Render/Heroku/nginx = 1)
# TRUST_PROXY=1

# # ---- Email (Resend) ----
# RESEND_API_KEY=
# RESEND_FROM=GFMSC <onboarding@resend.dev>
# CONTACT_TO=

# # ---- Payments ----
# # Live gateways (leave empty to disable). Demo gateway is allowed ONLY when NODE_ENV != production AND this is true:
# PAYMENTS_DEMO_MODE=false
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASS=
# SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_BASE_URL=https://checkout.sandbox.bka.sh

# # ---- SMS / Redis (optional) ----
# SMS_GATEWAY_URL=
# SMS_API_KEY=
# REDIS_URL=
PORT=5000
MONGO_URI=mongodb+srv://dina_admin:Dina1234@cluster0.u6aydwl.mongodb.net/GFMSC?retryWrites=true&w=majority
JWT_SECRET=02eb08dc854f927565a496dac89b4c4cadefc482e5b500cd33f5230871b7a510bd4def278892acca781ef43def26ff0e
