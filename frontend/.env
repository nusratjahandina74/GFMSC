# IMPORTANT:
# This value gets baked into the frontend build at BUILD TIME by Vite.
# For local development this points to your local backend.
# For the PRODUCTION build (Vercel), this MUST be overridden by setting
# VITE_API_BASE_URL in the Vercel Project Settings -> Environment Variables
# to your deployed backend URL + /api, e.g. https://gfmsc-backend.onrender.com/api
# Do NOT rely on this file alone for production — Vercel env vars take
# precedence, but only if you actually set them there.
VITE_API_BASE_URL=http://localhost:5000/api
